${__SOURCED__:+return}

# Parse global options
#
while [ $# -gt 0 ]; do
    case $1 in
        -q|--quiet)   QUIET=yes ;;
        -h|--help)    print_help; exit 0 ;;
        -V|--version) print_version; exit 0 ;;
        -*)           warn "Unknown option: $1"; print_help; exit 1 ;;
        *)            break ;;
    esac
    shift
done

if [ $# -lt 1 ]; then
    print_help
    exit 1
fi

cmd=$1
shift

case $cmd in
    clone)    cmd_clone "$@" ;;
    check)    cmd_check "$@" ;;
    init)     cmd_init "$@" ;;
    link)     cmd_link "$@" ;;
    worktree) cmd_worktree "$@" ;;
    *)
        warn "Unknown command: $cmd"
        print_help
        exit 1
        ;;
esac
